@{
    ViewData["Title"] = "Админ-панель";
}

<div class="admin-container" style="padding: 120px 0 60px; max-width: 1200px; margin: 0 auto;">
    <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 30px;">Админ-панель</h1>
    
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
        <!-- Статистика -->
        <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <div style="font-size: 14px; color: #666; margin-bottom: 10px;">Товаров</div>
            <div style="font-size: 36px; font-weight: 700; color: #ff5b00;">@ViewBag.TotalProducts</div>
        </div>
        
        <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <div style="font-size: 14px; color: #666; margin-bottom: 10px;">Категорий</div>
            <div style="font-size: 36px; font-weight: 700; color: #28a745;">@ViewBag.TotalCategories</div>
        </div>
        
        <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <div style="font-size: 14px; color: #666; margin-bottom: 10px;">Бронирований</div>
            <div style="font-size: 36px; font-weight: 700; color: #007bff;">@ViewBag.TotalBookings</div>
        </div>
        
        <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <div style="font-size: 14px; color: #666; margin-bottom: 10px;">Пользователей</div>
            <div style="font-size: 36px; font-weight: 700; color: #dc3545;">@ViewBag.TotalUsers</div>
        </div>
    </div>
    
    <!-- Меню админки -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        <a href="@Url.Action("Products")" style="background: white; padding: 30px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); text-decoration: none; color: #333; text-align: center;">
            <i class="fas fa-box" style="font-size: 48px; color: #ff5b00; margin-bottom: 15px;"></i>
            <h3 style="font-size: 18px; margin-bottom: 10px;">Управление товарами</h3>
            <p style="color: #666; font-size: 14px;">Добавление, редактирование, удаление товаров</p>
        </a>
        
        <a href="@Url.Action("Categories")" style="background: white; padding: 30px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); text-decoration: none; color: #333; text-align: center;">
            <i class="fas fa-folder" style="font-size: 48px; color: #28a745; margin-bottom: 15px;"></i>
            <h3 style="font-size: 18px; margin-bottom: 10px;">Категории</h3>
            <p style="color: #666; font-size: 14px;">Управление категориями товаров</p>
        </a>
        
        <a href="@Url.Action("Bookings")" style="background: white; padding: 30px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); text-decoration: none; color: #333; text-align: center;">
            <i class="fas fa-calendar-check" style="font-size: 48px; color: #007bff; margin-bottom: 15px;"></i>
            <h3 style="font-size: 18px; margin-bottom: 10px;">Бронирования</h3>
            <p style="color: #666; font-size: 14px;">Просмотр и управление бронированиями</p>
        </a>
    </div>
</div>