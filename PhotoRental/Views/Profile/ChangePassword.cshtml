@model PhotoRental.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="profile-container" style="padding: 120px 0 60px;">
    <div class="container">
        <h1 style="font-size: 32px; font-weight: 700; color: #333; margin-bottom: 30px;">Смена пароля</h1>

        <!-- Навигация -->
        <div style="display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 2px solid #eaeaea; padding-bottom: 15px;">
            <a href="@Url.Action("Index", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Обзор</a>
            <a href="@Url.Action("Bookings", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Мои бронирования</a>
            <a href="@Url.Action("Edit", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Личные данные</a>
            <a href="@Url.Action("ChangePassword", "Profile")" style="padding: 10px 20px; background: #ff5b00; color: white; border-radius: 25px; text-decoration: none;">Смена пароля</a>
            <a href="@Url.Action("Reviews", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Мои отзывы</a>
            <a href="@Url.Action("Payments", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Платежи</a>
        </div>

        <!-- Сообщение об успехе -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 10px; margin-bottom: 20px; text-align: center; font-weight: 500;">
                <i class="fas fa-check-circle" style="margin-right: 8px;"></i> @TempData["SuccessMessage"]
            </div>
        }

        <!-- Блок для общих ошибок (как в регистрации) -->
        @if (ViewData.ModelState[""]?.Errors.Count > 0)
        {
            <div class="validation-error">
                <i class="fas fa-exclamation-circle"></i>
                <div class="error-content">
                    @foreach (var error in ViewData.ModelState[""].Errors)
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            </div>
        }

        <div style="max-width: 500px; margin: 0 auto;">
            <div style="background: white; border-radius: 15px; padding: 30px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 25px;">Изменение пароля</h2>

                <form method="post" asp-action="ChangePassword" class="auth-form" id="changePasswordForm">
                    <!-- Текущий пароль (как в регистрации) -->
                    <div class="input-group">
                        <label class="input-label">
                            <i class="fas fa-lock"></i>
                            Текущий пароль
                        </label>
                        <input type="password"
                               name="CurrentPassword"
                               class="form-input"
                               placeholder="••••••••"
                               required
                               id="CurrentPassword" />
                        <div id="currentPasswordError" class="field-validation-error" style="display: none;"></div>
                    </div>

                    <!-- Новый пароль (как в регистрации) -->
                    <div class="input-group">
                        <label class="input-label">
                            <i class="fas fa-lock"></i>
                            Новый пароль
                        </label>
                        <input type="password"
                               name="NewPassword"
                               class="form-input"
                               placeholder="••••••••"
                               required
                               id="NewPassword" />
                        <div id="newPasswordError" class="field-validation-error" style="display: none;"></div>
                        <small style="color: #999; font-size: 13px;">Минимум 6 символов</small>
                    </div>

                    <!-- Подтверждение пароля (как в регистрации) -->
                    <div class="input-group">
                        <label class="input-label">
                            <i class="fas fa-lock"></i>
                            Подтвердите новый пароль
                        </label>
                        <input type="password"
                               name="ConfirmPassword"
                               class="form-input"
                               placeholder="••••••••"
                               required
                               id="ConfirmPassword" />
                        <div id="confirmPasswordError" class="field-validation-error"></div>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">
                        <i class="fas fa-key"></i>
                        Изменить пароль
                    </button>
                </form>
            </div>

            <!-- Советы по безопасности -->
            <div style="background: #e7f3ff; border-radius: 15px; padding: 20px; margin-top: 20px;">
                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 10px;">Советы по безопасности</h3>
                <ul style="margin: 0; padding-left: 20px; color: #0056b3; font-size: 14px;">
                    <li>Используйте уникальный пароль</li>
                    <li>Не сообщайте пароль третьим лицам</li>
                    <li>Регулярно меняйте пароль</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Стили для ошибок (как в регистрации) -->
<style>
    .field-validation-error {
        color: #dc3545;
        font-size: 13px;
        margin-top: 5px;
        padding-left: 5px;
        font-weight: 500;
        display: block;
    }
    
    .input-group {
        margin-bottom: 20px;
    }
    
    .form-input.error {
        border-color: #dc3545 !important;
        background-color: #fff8f8;
    }
    
    .form-input.valid {
        border-color: #28a745 !important;
    }
    
    .validation-error {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
        .validation-error i {
            color: #dc3545;
            font-size: 20px;
        }
    
        .validation-error .error-content p {
            color: #dc3545;
            margin: 0;
            font-size: 14px;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Получаем элементы (как в регистрации)
            const newPassword = document.getElementById('NewPassword');
            const confirmPassword = document.getElementById('ConfirmPassword');
            const newPasswordError = document.getElementById('newPasswordError');
            const confirmPasswordError = document.getElementById('confirmPasswordError');

            // Функция проверки пароля (как в регистрации)
            function validateNewPassword() {
                const value = newPassword.value;
                
                if (value.length === 0) {
                    newPasswordError.style.display = 'none';
                    newPassword.classList.remove('error', 'valid');
                    return false;
                }
                
                if (value.length < 6) {
                    newPasswordError.textContent = 'Пароль должен содержать минимум 6 символов';
                    newPasswordError.style.display = 'block';
                    newPassword.classList.add('error');
                    newPassword.classList.remove('valid');
                    return false;
                } else {
                    newPasswordError.style.display = 'none';
                    newPassword.classList.add('valid');
                    newPassword.classList.remove('error');
                    return true;
                }
            }

            // Функция проверки совпадения паролей (как в регистрации)
            function validatePasswordMatch() {
                const pwd = newPassword.value;
                const confirm = confirmPassword.value;
                
                if (confirm.length === 0) {
                    confirmPasswordError.textContent = '';
                    confirmPassword.classList.remove('error', 'valid');
                    return false;
                }
                
                if (pwd !== confirm) {
                    confirmPasswordError.textContent = 'Пароли не совпадают';
                    confirmPassword.classList.add('error');
                    confirmPassword.classList.remove('valid');
                    return false;
                } else {
                    if (pwd.length >= 6) {
                        confirmPasswordError.textContent = '✓ Пароли совпадают';
                        confirmPasswordError.style.color = '#28a745';
                        confirmPassword.classList.add('valid');
                        confirmPassword.classList.remove('error');
                    } else {
                        confirmPasswordError.textContent = '';
                        confirmPassword.classList.remove('valid', 'error');
                    }
                    return true;
                }
            }

            // Добавляем обработчики (как в регистрации)
            newPassword.addEventListener('input', function() {
                validateNewPassword();
                if (confirmPassword.value.length > 0) {
                    validatePasswordMatch();
                }
            });

            confirmPassword.addEventListener('input', validatePasswordMatch);

            // Проверка при потере фокуса (как в регистрации)
            newPassword.addEventListener('blur', validateNewPassword);
            confirmPassword.addEventListener('blur', validatePasswordMatch);

            // Проверка перед отправкой (как в регистрации)
            document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
                const isNewPasswordValid = validateNewPassword();
                const isMatchValid = newPassword.value === confirmPassword.value && newPassword.value.length >= 6;
                
                let hasError = false;
                let errorMessage = '';
                
                if (!isNewPasswordValid) {
                    errorMessage += '• Пароль должен содержать минимум 6 символов\n';
                    hasError = true;
                }
                
                if (newPassword.value !== confirmPassword.value) {
                    errorMessage += '• Пароли не совпадают\n';
                    hasError = true;
                }
                
                if (hasError) {
                    e.preventDefault();
                    alert('Пожалуйста, исправьте следующие ошибки:\n\n' + errorMessage);
                }
            });
        });
    </script>
}