@model PhotoRental.Models.Admin.ProductListViewModel

@{
    ViewData["Title"] = "Управление товарами";
}

<div class="admin-container" style="padding: 120px 0 60px; max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1 style="font-size: 32px; font-weight: 700;">Управление товарами</h1>
        <a href="@Url.Action("CreateProduct")" class="btn-primary" style="padding: 12px 25px;">
            <i class="fas fa-plus"></i> Добавить товар
        </a>
    </div>
    
    <!-- Поиск и фильтры -->
    <div style="background: white; border-radius: 15px; padding: 20px; margin-bottom: 30px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
        <div style="display: flex; gap: 15px;">
            <input type="text" id="searchInput" value="@Model.SearchQuery" placeholder="Поиск по названию..."
                   style="flex: 1; padding: 12px; border: 2px solid #eaeaea; border-radius: 10px;" />
            
            <select id="categorySelect" style="width: 200px; padding: 12px; border: 2px solid #eaeaea; border-radius: 10px;">
                <option value="">Все категории</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                }
            </select>
        </div>
    </div>
    
    <!-- Таблица товаров -->
    <div id="productsContainer" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
        <table style="width: 100%; border-collapse: collapse;">
            <thead style="background: #f8f9fa;">
                <tr>
                    <th style="padding: 15px; text-align: left;">Изображение</th>
                    <th style="padding: 15px; text-align: left;">Название</th>
                    <th style="padding: 15px; text-align: left;">Категория</th>
                    <th style="padding: 15px; text-align: left;">Цена/день</th>
                    <th style="padding: 15px; text-align: left;">Статус</th>
                    <th style="padding: 15px; text-align: left;">Действия</th>
                </tr>
            </thead>
            <tbody id="productsTableBody">
                @foreach (var product in Model.Products)
                {
                    <tr style="border-top: 1px solid #eaeaea;">
                        <td style="padding: 15px;">
                            <img src="@(product.ImageUrl ?? "https://via.placeholder.com/50")"
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                        </td>
                        <td style="padding: 15px;">
                            <strong>@product.Name</strong><br />
                            <small style="color: #666;">@product.Brand @product.Model</small>
                        </td>
                        <td style="padding: 15px;">@product.Category?.Name</td>
                        <td style="padding: 15px;">@product.PricePerDay.ToString("C2")</td>
                        <td style="padding: 15px;">
                            @if (product.IsAvailable == true)
                            {
                                <span style="background: #d4edda; color: #155724; padding: 5px 10px; border-radius: 15px; font-size: 12px;">
                                    Доступен
                                </span>
                            }
                            else
                            {
                                <span style="background: #f8d7da; color: #721c24; padding: 5px 10px; border-radius: 15px; font-size: 12px;">
                                    Недоступен
                                </span>
                            }
                        </td>
                        <td style="padding: 15px;">
                            <a href="@Url.Action("EditProduct", new { id = product.Id })" style="color: #007bff; margin-right: 10px;">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="/Admin/DeleteProduct" method="post" style="display: inline;"
                                  onsubmit="return confirm('Удалить товар?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" style="background: none; border: none; color: #dc3545; cursor: pointer;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <div style="display: flex; justify-content: center; gap: 10px; margin-top: 30px;">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("Products", new { page = i, search = Model.SearchQuery, categoryId = Model.CategoryId })"
                       style="width: 40px; height: 40px; background: @(i == Model.CurrentPage ? "#ff5b00" : "#f5f5f5"); color: @(i == Model.CurrentPage ? "white" : "#333"); border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                    @i
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const categorySelect = document.getElementById('categorySelect');
            
            let searchTimeout;
            
            function reloadProducts() {
                const search = searchInput.value;
                const categoryId = categorySelect.value;
                
                window.location.href = '@Url.Action("Products")?search=' + encodeURIComponent(search) +
                                      '&categoryId=' + encodeURIComponent(categoryId);
            }
            
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(reloadProducts, 500);
            });
            
            categorySelect.addEventListener('change', reloadProducts);
        });
    </script>
}