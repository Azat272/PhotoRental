@model PhotoRental.Models.ProfileDashboardViewModel

@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="profile-container" style="padding: 120px 0 60px;">
    <div class="container">
        <!-- Приветствие -->
        <div class="welcome-section" style="margin-bottom: 30px;">
            <h1 style="font-size: 32px; font-weight: 700; color: #333;">
                Здравствуйте, @Model.User.FullName!
            </h1>
            <p style="color: #666; font-size: 16px; margin-top: 10px;">
                Добро пожаловать в ваш личный кабинет
            </p>
        </div>

        <!-- Статистика -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
            <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="width: 50px; height: 50px; background: rgba(255,91,0,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-calendar-check" style="color: #ff5b00; font-size: 24px;"></i>
                    </div>
                    <div>
                        <div style="font-size: 28px; font-weight: 700; color: #333;">@Model.ActiveBookingsCount</div>
                        <div style="color: #666; font-size: 14px;">Активных бронирований</div>
                    </div>
                </div>
            </div>

            <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="width: 50px; height: 50px; background: rgba(40,167,69,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-check-circle" style="color: #28a745; font-size: 24px;"></i>
                    </div>
                    <div>
                        <div style="font-size: 28px; font-weight: 700; color: #333;">@Model.CompletedBookingsCount</div>
                        <div style="color: #666; font-size: 14px;">Завершенных аренд</div>
                    </div>
                </div>
            </div>

            <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="width: 50px; height: 50px; background: rgba(0,123,255,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-ruble-sign" style="color: #007bff; font-size: 24px;"></i>
                    </div>
                    <div>
                        <div style="font-size: 28px; font-weight: 700; color: #333;">@Model.TotalSpent.ToString("C2")</div>
                        <div style="color: #666; font-size: 14px;">Всего потрачено</div>
                    </div>
                </div>
            </div>

            <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="width: 50px; height: 50px; background: rgba(255,193,7,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-shopping-cart" style="color: #ffc107; font-size: 24px;"></i>
                    </div>
                    <div>
                        <div style="font-size: 28px; font-weight: 700; color: #333;">@Model.CartItemsCount</div>
                        <div style="color: #666; font-size: 14px;">Товаров в корзине</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Навигация -->
        <div style="display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 2px solid #eaeaea; padding-bottom: 15px;">
            <a href="@Url.Action("Index", "Profile")" style="padding: 10px 20px; background: #ff5b00; color: white; border-radius: 25px; text-decoration: none;">Обзор</a>
            <a href="@Url.Action("Bookings", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Мои бронирования</a>
            <a href="@Url.Action("Edit", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Личные данные</a>
            <a href="@Url.Action("ChangePassword", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Смена пароля</a>
            <a href="@Url.Action("Reviews", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Мои отзывы</a>
            <a href="@Url.Action("Payments", "Profile")" style="padding: 10px 20px; color: #666; text-decoration: none;">Платежи</a>
        </div>

        <!-- Последние бронирования -->
        <div style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 20px;">Последние бронирования</h2>
            
            @if (Model.RecentBookings.Any())
            {
                <div style="display: grid; gap: 15px;">
                    @foreach (var booking in Model.RecentBookings)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 15px; border: 1px solid #eaeaea; border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 15px;">
                                <img src="@booking.Product.ImageUrl" alt="@booking.Product.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                <div>
                                    <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 5px;">@booking.Product.Name</h3>
                                    <p style="color: #666; font-size: 14px;">
                                        @booking.StartDate.ToString("dd.MM.yyyy") - @booking.EndDate.ToString("dd.MM.yyyy")
                                    </p>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 20px;">
                                @{
                                    string statusClass = "";
                                    string statusText = "";
                                    
                                    if (booking.Status == "Active")
                                    {
                                        statusClass = "background: #d4edda; color: #155724;";
                                        statusText = "Активно";
                                    }
                                    else if (booking.Status == "Pending")
                                    {
                                        statusClass = "background: #fff3cd; color: #856404;";
                                        statusText = "Ожидает";
                                    }
                                    else if (booking.Status == "Completed")
                                    {
                                        statusClass = "background: #d4edda; color: #155724;";
                                        statusText = "Завершено";
                                    }
                                    else
                                    {
                                        statusClass = "background: #f8d7da; color: #721c24;";
                                        statusText = "Отменено";
                                    }
                                }
                                <span style="padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; @statusClass">
                                    @statusText
                                </span>
                                <a href="@Url.Action("BookingDetails", "Profile", new { id = booking.Id })" style="color: #ff5b00; text-decoration: none;">
                                    Подробнее <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color: #999; text-align: center; padding: 30px;">У вас пока нет бронирований</p>
            }
        </div>
    </div>
</div>