@model PhotoRental.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Оформление заказа";
}

<link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<section class="checkout-container">
    <div class="container-custom">
        <h1 class="page-title">Оформление заказа</h1>

        <form asp-action="Create" asp-controller="Booking" method="post" id="checkoutForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="error-message" style="display:block;"></div>

            <div class="checkout-grid">
                <div>
                    <div class="checkout-section">
                        <h3 class="section-title">Контактная информация</h3>

                        <div class="form-group">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="form-input" id="customerName" />
                            <span asp-validation-for="CustomerName" class="error-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CustomerPhone" class="form-label"></label>
                            <input asp-for="CustomerPhone" class="form-input" id="customerPhone" placeholder="+7 (999) 123-45-67" />
                            <span asp-validation-for="CustomerPhone" class="error-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CustomerEmail" class="form-label"></label>
                            <input asp-for="CustomerEmail" class="form-input" id="customerEmail" placeholder="example@mail.com" />
                            <span asp-validation-for="CustomerEmail" class="error-message"></span>
                        </div>
                    </div>

                    <div class="checkout-section">
                        <h3 class="section-title">Период аренды</h3>

                        <div class="dates-grid">
                            <div class="date-field">
                                <label asp-for="StartDate"></label>
                                <input asp-for="StartDate" type="date" id="startDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="StartDate" class="error-message"></span>
                            </div>

                            <div class="date-field">
                                <label asp-for="EndDate"></label>
                                <input asp-for="EndDate" type="date" id="endDate" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="EndDate" class="error-message"></span>
                            </div>
                        </div>

                        <div class="rental-days">
                            <span>Количество дней аренды:</span>
                            <span id="rentalDays">@Model.Days</span>
                        </div>

                        <div class="rental-days highlight">
                            <span>Стоимость аренды:</span>
                            <span id="rentalCost">@Model.RentalCost.ToString("C2")</span>
                        </div>

                        <div id="dateError" class="error-message"></div>
                    </div>

                    <div class="checkout-section">
                        <h3 class="section-title">Способ получения</h3>

                        <div class="options-container">
                            <label class="pickup-option @(Model.DeliveryType == "delivery" ? "selected" : "")">
                                <input type="radio" name="DeliveryType" value="delivery" @(Model.DeliveryType == "delivery" ? "checked" : "")>
                                <span>Доставка курьером</span>
                                <span class="pickup-address">+500 ₽</span>
                            </label>

                            <label class="pickup-option @(Model.DeliveryType == "pickup" ? "selected" : "")">
                                <input type="radio" name="DeliveryType" value="pickup" @(Model.DeliveryType == "pickup" ? "checked" : "")>
                                <span>Самовывоз</span>
                                <span class="pickup-address">Бесплатно</span>
                            </label>
                        </div>

                        <div id="deliveryBlock" style="display: @(Model.DeliveryType == "delivery" ? "block" : "none");">
                            <label class="form-label" asp-for="Address"></label>
                            <div class="address-search">
                                <input asp-for="Address" id="addressInput" class="form-input" placeholder="Введите адрес" autocomplete="off" />
                                <span asp-validation-for="Address" class="error-message"></span>
                            </div>

                            <input asp-for="Apartment" class="form-input" placeholder="№ квартиры, офиса" />
                            <input asp-for="CourierComment" class="form-input" placeholder="Комментарий курьеру" />
                        </div>

                        <div id="pickupBlock" style="display: @(Model.DeliveryType == "pickup" ? "block" : "none");">
                            <div class="pickup-info">
                                <p><i class="fas fa-map-marker-alt"></i> г. Москва, ул. Тверская, 15</p>
                                <p><i class="fas fa-clock"></i> Пн-Пт: 10:00 - 20:00, Сб-Вс: 11:00 - 18:00</p>
                                <p><i class="fas fa-phone"></i> +7 (999) 123-45-67</p>
                            </div>
                        </div>
                    </div>

                    <div class="checkout-section">
                        <h3 class="section-title">Способ оплаты</h3>
                        <div class="options-container">
                            <label class="payment-option">
                                <input type="radio" name="PaymentMethod" value="card" @(Model.PaymentMethod == "card" ? "checked" : "")>
                                <span>Банковской картой</span>
                                <span class="payment-info">Онлайн</span>
                            </label>

                            <label class="payment-option">
                                <input type="radio" name="PaymentMethod" value="cash" @(Model.PaymentMethod == "cash" ? "checked" : "")>
                                <span>Наличными</span>
                                <span class="payment-info">При получении</span>
                            </label>
                        </div>
                    </div>

                    <div class="checkout-section">
                        <h3 class="section-title">Дополнительно</h3>
                        <textarea asp-for="Comment" rows="4" class="form-input" placeholder="Особые пожелания"></textarea>
                    </div>
                </div>

                <div>
                    <div class="checkout-section">
                        <h3 class="section-title">Ваш заказ</h3>

                        @foreach (var item in Model.Items)
                        {
                            <div class="order-item">
                                <div class="order-item-info">
                                    <img src="@(item.ImageUrl ?? "https://via.placeholder.com/60x60")" alt="@item.ProductName">
                                    <div class="order-item-details">
                                        <h4>@item.ProductName</h4>
                                        <p>@item.Quantity шт. × @item.PricePerDay.ToString("C2")/день</p>
                                    </div>
                                </div>
                                <div class="order-item-price">@((item.PricePerDay * item.Quantity).ToString("C2"))</div>
                            </div>
                        }

                        <div class="total-row">
                            <span>Товары (@Model.TotalItems шт.):</span>
                            <span>@Model.ItemsTotal.ToString("C2")</span>
                        </div>

                        <div class="total-row" id="deliveryCostRow">
                            <span>Доставка:</span>
                            <span id="deliveryCost">@Model.DeliveryCost.ToString("C2")</span>
                        </div>

                        <div class="total-row grand-total">
                            <span>Итого:</span>
                            <span id="totalAmount">@Model.GrandTotal.ToString("C2")</span>
                        </div>

                        <input type="hidden" asp-for="Days" id="hiddenRentalDays" />
                        <input type="hidden" asp-for="DeliveryCost" id="hiddenDeliveryCost" />
                        <input type="hidden" asp-for="TotalAmount" id="hiddenTotalAmount" />

                        <button type="submit" class="confirm-btn" id="submitBtn">
                            <i class="fas fa-check-circle"></i> Подтвердить заказ
                        </button>

                        <p class="terms-text">
                            <i class="fas fa-info-circle"></i> Нажимая кнопку, вы соглашаетесь с условиями аренды
                        </p>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const startDate = document.getElementById('startDate');
            const endDate = document.getElementById('endDate');
            const rentalDaysSpan = document.getElementById('rentalDays');
            const rentalCostSpan = document.getElementById('rentalCost');
            const deliveryCostSpan = document.getElementById('deliveryCost');
            const totalAmountSpan = document.getElementById('totalAmount');
            const hiddenDays = document.getElementById('hiddenRentalDays');
            const hiddenDelivery = document.getElementById('hiddenDeliveryCost');
            const hiddenTotal = document.getElementById('hiddenTotalAmount');
            const deliveryBlock = document.getElementById('deliveryBlock');
            const pickupBlock = document.getElementById('pickupBlock');
            const addressInput = document.getElementById('addressInput');
            const dateError = document.getElementById('dateError');
            const submitBtn = document.getElementById('submitBtn');
            const baseDailyAmount = @Model.ItemsTotal;

            function formatCurrency(amount) {
                return new Intl.NumberFormat('ru-RU', {
                    style: 'currency',
                    currency: 'RUB',
                    maximumFractionDigits: 0
                }).format(amount);
            }

            function calculateDays() {
                if (!startDate.value || !endDate.value) return 0;
                const start = new Date(startDate.value);
                const end = new Date(endDate.value);
                start.setHours(0, 0, 0, 0);
                end.setHours(0, 0, 0, 0);
                return Math.ceil((end - start) / (1000 * 60 * 60 * 24));
            }

            function updateSummary() {
                const days = calculateDays();
                if (days < 1) {
                    dateError.textContent = 'Дата окончания должна быть позже даты начала';
                    dateError.style.display = 'block';
                    submitBtn.disabled = true;
                    return;
                }

                dateError.style.display = 'none';
                submitBtn.disabled = false;

                const deliveryType = document.querySelector('input[name="DeliveryType"]:checked')?.value ?? 'pickup';
                const delivery = deliveryType === 'delivery' ? 500 : 0;
                const rentalCost = baseDailyAmount * days;

                rentalDaysSpan.textContent = days;
                rentalCostSpan.textContent = formatCurrency(rentalCost);
                deliveryCostSpan.textContent = formatCurrency(delivery);
                totalAmountSpan.textContent = formatCurrency(rentalCost + delivery);

                hiddenDays.value = days;
                hiddenDelivery.value = delivery;
                hiddenTotal.value = rentalCost + delivery;
            }

            function toggleDelivery() {
                const deliveryType = document.querySelector('input[name="DeliveryType"]:checked')?.value;

                document.querySelectorAll('.pickup-option').forEach(el => el.classList.remove('selected'));
                const selected = document.querySelector(`input[name="DeliveryType"][value="${deliveryType}"]`)?.closest('.pickup-option');
                selected?.classList.add('selected');

                if (deliveryType === 'delivery') {
                    deliveryBlock.style.display = 'block';
                    pickupBlock.style.display = 'none';
                    addressInput.required = true;
                } else {
                    deliveryBlock.style.display = 'none';
                    pickupBlock.style.display = 'block';
                    addressInput.required = false;
                }

                updateSummary();
            }

            startDate.addEventListener('change', function () {
                const start = new Date(this.value);
                start.setDate(start.getDate() + 1);
                endDate.min = start.toISOString().split('T')[0];
                if (endDate.value && endDate.value < endDate.min) {
                    endDate.value = endDate.min;
                }
                updateSummary();
            });

            endDate.addEventListener('change', updateSummary);
            document.querySelectorAll('input[name="DeliveryType"]').forEach(el => el.addEventListener('change', toggleDelivery));

            toggleDelivery();
            updateSummary();
        });
    </script>
}
